flowchart TB
  subgraph UIC["Tầng giao diện — được phép đụng DOM"]
    direction TB
    LEG["js/legacy/legacy.js<br/>tab 'Hành trình cơ bản'<br/>(bộ mô phỏng gốc, giữ nguyên)"]
    SHELL["js/ui/shell.js<br/>tab 'Phòng thí nghiệm'<br/>(chọn kịch bản, thanh phát, sơ đồ SVG)"]
    STUBS["js/modules/_stubs/stubs.js<br/>5 panel tạm<br/>(chờ tích hợp)"]
  end

  subgraph CORE["js/core — không đụng DOM, nạp được bằng require() trong Node"]
    direction TB
    REG["registry.js<br/>registerScenario / registerProtocol<br/>registerPanel / registerTopology / loadScenario"]
    ENG["engine.js<br/>build(state, action) → Trace<br/>createPlayer(trace, {onStep})"]
    STO["store.js<br/>createStore: get / set / subscribe"]
    BUS["bus.js<br/>on / emit / clear"]
    MOD["model.js<br/>Topology, Device, Interface, Link, Route<br/>applyMutations, cloneState"]
    NET["net.js<br/>IPv4, sameSubnet, lpm, macFor"]
  end

  SCEN["scenarios/*.js<br/>ref_hai_router + _skeleton_A..X<br/>(đối tượng JSON-compatible)"]

  SCEN -->|"gọi registerScenario"| REG
  STUBS -->|"gọi registerPanel"| REG
  SHELL -->|"loadScenario, listScenarios"| REG
  SHELL -->|"createStore"| STO
  SHELL -->|"build, createPlayer"| ENG
  SHELL -->|"emit sự kiện theo bước"| BUS
  SHELL -->|"isValidIp"| NET
  ENG -->|"require"| MOD
  ENG -->|"require"| NET
  REG -->|"require"| MOD
